# ---- Gemini cookies (from gemini.google.com -> DevTools -> Network -> copy the
#      cookie header of any request).  PSID is required, PSIDTS is optional but
#      recommended for auto-refresh.
GEMINI_PSID=
GEMINI_PSIDTS=

# Alternative: point at a JSON file containing {"__Secure-1PSID": "...", "__Secure-1PSIDTS": "..."}
# GEMINI_COOKIE_FILE=/data/cookies.json

# API key Kimi Code sends as Authorization: Bearer. Set it and use the same value
# as api_key in config.toml. Leave empty to disable auth (only on trusted hosts).
BRIDGE_API_KEY=change-me

# Model id advertised by the bridge (use this in config.toml model field)
BRIDGE_MODEL_ID=gemini-web

# Optional: force a specific Gemini model on the wrapper (name/alias/id the
# account knows, e.g. gemini-flash or gemini-pro). Empty = account default.
# GEMINI_MODEL=

# HTTP port
PORT=8787

# Where auto-refreshed cookies are persisted (mount a volume here)
DATA_DIR=/data

# Per-request timeout in seconds
REQUEST_TIMEOUT=900

# Keep only this many characters of conversation per request
MAX_TRANSCRIPT_CHARS=1500000

LOG_LEVEL=INFO
